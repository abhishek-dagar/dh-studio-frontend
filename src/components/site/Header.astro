---
import Download from '@lucide/astro/icons/download';
import Menu from '@lucide/astro/icons/menu';
import { ThemeToggle } from '../../islands/ThemeToggle';
import { withTrailingSlash } from '../../lib/seo/paths';
import { downloadHref, navLinks } from '../../lib/site';
import { buttonClass } from '../../lib/ui/button';
import Button from '../ui/Button.astro';
import Logo from './Logo.astro';

// Floating glass pill header (spec 0002, AC-14). Sticky just below the top of
// the viewport, centered and capped at --width-nav. Glass and its solid
// fallbacks live in depth.css. Below md the links and the theme toggle move
// into a native popover menu, which handles Escape, outside clicks and returning
// focus to its button. Logo, Menu and Download always stay in the pill.
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Download always goes to the download page, which handles a build without release data itself (spec 0005, AC-17).
const onDownloadPage = withTrailingSlash(currentPath) === downloadHref;

// Section pages (the changelog list, its pages and each version) mark their
// link current from any path beneath it.
const path = withTrailingSlash(currentPath);
const isCurrent = (href: string): boolean =>
  href === currentPath || (href.startsWith('/') && href.endsWith('/') && href !== '/' && path.startsWith(href));
const navLinkClass = [
  'inline-flex h-11 items-center rounded-button px-3 text-[0.875rem] font-medium text-fg-muted',
  'transition-[background-color,color] duration-(--dur-fast)',
  'hover:bg-wash hover:text-fg aria-[current=page]:bg-wash aria-[current=page]:text-fg',
].join(' ');
---

<header class="pointer-events-none sticky top-(--header-offset) z-40 mt-(--header-offset) px-(--gutter)">
  <div
    class="header-pill pointer-events-auto mx-auto flex h-(--header-h) max-w-(--width-nav) items-center justify-between gap-2 rounded-pill border border-line ps-3 pe-1.5 shadow-(--shadow-header)"
  >
    <a href="/" class="-ms-1 rounded-button p-1" aria-current={isCurrent('/') ? 'page' : undefined}>
      <Logo />
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-0.5">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class={navLinkClass} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden md:block">
        <ThemeToggle client:idle />
      </div>

      <button
        type="button"
        popovertarget="site-menu"
        aria-controls="site-menu"
        aria-label="Menu"
        class={buttonClass({ variant: 'ghost', iconOnly: true, className: 'md:hidden' })}
      >
        <Menu aria-hidden="true" />
      </button>

      <Button href={downloadHref} current={onDownloadPage} class="ms-1">
        <Download aria-hidden="true" class="hidden sm:block" />
        Download
      </Button>
    </div>
  </div>

  <nav
    id="site-menu"
    popover
    aria-label="Main"
    class="pointer-events-auto fixed inset-auto top-[calc(var(--header-offset)+var(--header-h)+0.5rem)] right-(--gutter) m-0 w-[min(20rem,calc(100vw-2*var(--gutter)))] rounded-surface border border-line bg-floating p-2 text-fg shadow-(--shadow-floating) md:hidden"
  >
    <ul class="flex flex-col gap-0.5">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class:list={[navLinkClass, 'flex w-full']} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-2 flex items-center justify-between border-t border-line ps-3 pt-2">
      <span class="text-[0.875rem] font-medium text-fg-muted">Theme</span>
      <ThemeToggle client:idle />
    </div>
  </nav>
</header>
