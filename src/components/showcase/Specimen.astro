---
import Surface from '../ui/Surface.astro';

// A titled specimen inside a chapter: what the piece is, and the piece itself.
interface Props {
  title: string;
  note?: string;
  class?: string;
}

const { title, note, class: className } = Astro.props;
---

<Surface as="article" class:list={['flex min-w-0 flex-col gap-6', className]}>
  <header class="flex flex-col gap-1.5">
    <h3 class="text-h3">{title}</h3>
    {note !== undefined && <p class="max-w-(--width-prose) text-caption text-fg-muted">{note}</p>}
  </header>
  <slot />
</Surface>
