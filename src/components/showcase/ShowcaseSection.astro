---
import Section from '../ui/Section.astro';

// One chapter of the design system page: a named, linkable section with a short intro.
interface Props {
  id: string;
  title: string;
  intro: string;
}

const { id, title, intro } = Astro.props;
---

<Section id={id} labelledby={`${id}-title`} class="border-t border-line first:border-t-0">
  <div class="flex flex-col gap-10">
    <header class="flex max-w-(--width-prose) flex-col gap-3">
      <h2 id={`${id}-title`} class="text-h2">{title}</h2>
      <p class="text-fg-muted">{intro}</p>
    </header>
    <slot />
  </div>
</Section>
