---
// A page section with the shared vertical rhythm (spec 0002).
interface Props {
  id?: string;
  /** Id of the heading that names this section. */
  labelledby?: string;
  as?: 'section' | 'div' | 'article';
  class?: string;
}

const { id, labelledby, as: Tag = 'section', class: className } = Astro.props;
---

<Tag id={id} aria-labelledby={labelledby} class:list={['scroll-mt-[calc(var(--header-offset)+var(--header-h)+1rem)] py-(--space-section)', className]}>
  <slot />
</Tag>
