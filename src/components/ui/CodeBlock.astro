---
import type { ComponentProps } from 'astro/types';
import { Code } from 'astro:components';
import { CopyButton } from '../../islands/CopyButton';

// Build time highlighted code (spec 0002). Shiki's css-variables theme reads the
// --syntax-* roles (mapped in base.css), so colors swap with the theme.
interface Props {
  code: string;
  lang: ComponentProps<typeof Code>['lang'];
  /** A file name or command context, shown in the bar. */
  title?: string;
  copy?: boolean;
  class?: string;
}

const { code, lang, title, copy = true, class: className } = Astro.props;
---

<figure class:list={['m-0 overflow-hidden rounded-field border border-line bg-surface', className]}>
  {
    (title !== undefined || copy) && (
      <div class="flex min-h-11 items-center justify-between gap-4 border-b border-line ps-4 pe-1">
        {title !== undefined ? (
          <figcaption class="truncate font-mono text-caption text-fg-muted">{title}</figcaption>
        ) : (
          <span />
        )}
        {copy && <CopyButton client:visible text={code} />}
      </div>
    )
  }
  <Code code={code} lang={lang} theme="css-variables" class="code-block" />
</figure>
