---
import type { EngineIcon } from '../../lib/home/engines';
import type { EngineSupport } from '../../lib/features/support';
import { engineIcons } from '../editor/engine-icons';

// A feature's "Works with" line (spec 0008, AC-5): every engine with its icon
// and name. A partial engine adds "(partly, <note>)"; an unsupported one is muted
// and says "(not supported, <note>)" in words, so it never rests on styling alone.
interface Props {
  id: string;
  label: string;
  words: { readonly partial: string; readonly none: string };
  engines: readonly { readonly name: string; readonly icon: EngineIcon }[];
  support: Readonly<Record<string, EngineSupport>>;
}

const { id, label, words, engines, support } = Astro.props;

const items = engines.map(({ name, icon }) => {
  const cell = support[icon] ?? { level: 'none' as const };
  const word = cell.level === 'full' ? undefined : words[cell.level];
  const qualifier = [word, cell.note].filter((part) => part !== undefined).join(', ');
  return { name, Icon: engineIcons[icon], none: cell.level === 'none', qualifier };
});
---

<div class="flex flex-col gap-2">
  <p id={id} class="text-caption font-medium text-fg-muted">{label}</p>
  <ul aria-labelledby={id} class="flex flex-wrap gap-x-5 gap-y-2 text-[0.875rem]">
    {
      items.map(({ name, Icon, none, qualifier }) => (
        <li class:list={['inline-flex items-center gap-2', { 'text-fg-muted': none }]}>
          <Icon class="engine-line-icon size-4 shrink-0" aria-hidden="true" />
          <span>
            {name}
            {qualifier !== '' && <span class="text-fg-muted"> ({qualifier})</span>}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  @media (forced-colors: active) {
    .engine-line-icon {
      color: CanvasText;
    }
  }
</style>
