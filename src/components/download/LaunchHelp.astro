---
import { osName } from '../../lib/home/format';
import type { LaunchTip } from '../../lib/home/download';
import type { Os } from '../../lib/release/types';
import CommandLine from '../ui/CommandLine.astro';
import Link from '../ui/Link.astro';
import Surface from '../ui/Surface.astro';

// First launch help, one card per system (spec 0005, AC-8). Static: all three
// show without JavaScript; once the query above picks a system, only its card
// shows (the island sets <html data-download-os>, the CSS below follows it).
// The section ends with a link per system to its install guide (spec 0009,
// AC-15), hidden and shown the same way.
interface Props {
  heading: string;
  note: string;
  /** In display order: macOS, Windows, Linux. */
  tips: readonly { readonly os: Os; readonly tip: LaunchTip }[];
  /** One install guide link per system, in the same order. */
  guides?: readonly { readonly os: Os; readonly href: string; readonly label: string }[];
}

const { heading, note, tips, guides = [] } = Astro.props;
---

<section aria-labelledby="launch-heading" class="flex flex-col gap-6">
  <div class="flex max-w-(--width-prose) flex-col gap-2">
    <h2 id="launch-heading" class="text-h2">{heading}</h2>
    <p class="text-fg-muted">{note}</p>
  </div>
  <ul class="launch-grid grid gap-4 md:grid-cols-3 md:gap-6">
    {
      tips.map(({ os, tip }) => (
        <Surface as="li" class="flex min-w-0 flex-col gap-3" data-launch-os={os}>
          <h3 class="text-h3">First launch on {osName(os)}</h3>
          <p class="font-medium text-fg">{tip.title}</p>
          <ol class="flex list-decimal flex-col gap-1 ps-5 text-fg-muted marker:text-fg-muted">
            {tip.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          {tip.command !== undefined && <CommandLine command={tip.command} class="mt-auto" />}
        </Surface>
      ))
    }
  </ul>
  {
    guides.length > 0 && (
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {guides.map((guide) => (
          <li data-launch-os={guide.os}>
            <Link href={guide.href}>{guide.label}</Link>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style is:global>
  :root[data-download-os='macos'] [data-launch-os]:not([data-launch-os='macos']),
  :root[data-download-os='windows'] [data-launch-os]:not([data-launch-os='windows']),
  :root[data-download-os='linux'] [data-launch-os]:not([data-launch-os='linux']) {
    display: none;
  }

  /* One card left: hold it to a readable width instead of a third of the row. */
  :root[data-download-os] .launch-grid {
    grid-template-columns: minmax(0, var(--width-prose));
  }
</style>
