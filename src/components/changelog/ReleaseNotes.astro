---
import { render } from 'astro:content';
import type { ReleaseEntry } from '../../lib/changelog';

// One release's notes (spec 0005, AC-3 to AC-5, AC-10): the HTML the loader
// stored, already escaped, link checked, and outlined from level 3 down.
interface Props {
  entry: ReleaseEntry;
  emptyNotes: string;
}

const { entry, emptyNotes } = Astro.props;
const { Content } = await render(entry);
const empty = (entry.rendered?.html ?? '').trim() === '';
---

{empty ? <p class="text-fg-muted">{emptyNotes}</p> : <div class="release-notes"><Content /></div>}

<style is:global>
  /* Notes markup comes from markdown, so it is styled here rather than with utilities. */
  .release-notes {
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .release-notes > :first-child {
    margin-block-start: 0;
  }

  .release-notes > :last-child {
    margin-block-end: 0;
  }

  .release-notes :is(h3, h4, h5, h6) {
    scroll-margin-top: calc(var(--header-offset) + var(--header-h) + 1rem);
    margin-block: 1.75rem 0.5rem;
    font-weight: 600;
  }

  .release-notes h3 {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
  }

  .release-notes :is(h4, h5, h6) {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .release-notes :is(p, ul, ol, blockquote, pre, table) {
    margin-block: 0.75rem;
  }

  .release-notes :is(ul, ol) {
    padding-inline-start: 1.25rem;
  }

  .release-notes ul {
    list-style: disc;
  }

  .release-notes ol {
    list-style: decimal;
  }

  .release-notes li + li,
  .release-notes li > :is(ul, ol) {
    margin-block-start: 0.375rem;
  }

  .release-notes li::marker {
    color: var(--fg-muted);
  }

  .release-notes strong {
    font-weight: 600;
  }

  .release-notes a[href] {
    color: var(--fg);
    text-decoration: underline 1px var(--line-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-fast);
  }

  .release-notes a[href]:hover {
    text-decoration-color: var(--fg);
  }

  .release-notes blockquote {
    border-inline-start: 2px solid var(--line);
    padding-inline-start: 1rem;
    color: var(--fg-muted);
  }

  .release-notes hr {
    margin-block: 1.5rem;
    border: 0;
    border-block-start: 1px solid var(--line);
  }

  .release-notes img {
    max-inline-size: 100%;
    block-size: auto;
  }

  /* Inline code, in Kbd's quiet chip. */
  .release-notes :not(pre) > code {
    border: 1px solid var(--line);
    border-radius: var(--radius-inset);
    background: var(--ground);
    padding: 0.05em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  /* Fenced code in the CodeBlock look, scrolling sideways inside itself (AC-3). */
  .release-notes pre {
    border: 1px solid var(--line);
    border-radius: var(--radius-field);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: var(--text-code--line-height);
  }

  .release-notes table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .release-notes :is(th, td) {
    border: 1px solid var(--line);
    padding: 0.375rem 0.75rem;
    text-align: start;
  }
</style>
