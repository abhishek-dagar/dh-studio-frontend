---
import PopupCard from '../../editor/PopupCard.astro';

// Keychain passwords: the PostgreSQL connection details after Next (spec 0003, AC-19). Decorative copy of the app.
interface Props {
  position: { readonly x: string; readonly y: string; readonly width: string };
}

const { position } = Astro.props;

const fields = [
  { label: 'host', value: 'localhost' },
  { label: 'port', value: '5432' },
  { label: 'database', value: 'project-planit' },
  { label: 'user', value: 'postgres' },
] as const;
---

<PopupCard position={position}>
  <p class="m-0 px-2 pt-1 pb-1.5 font-medium text-fg-muted">PostgreSQL connection</p>
  <dl class="m-0 grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1.5 px-2 pb-1.5">
    {
      fields.map((field) => (
        <>
          <dt class="text-fg-muted">{field.label}</dt>
          <dd class="m-0 rounded-inset border border-line bg-ground px-2 py-0.5 font-mono text-[0.92em]">{field.value}</dd>
        </>
      ))
    }
  </dl>
</PopupCard>
