---
import PopupCard from '../../editor/PopupCard.astro';

// Command palette: the result of Compare tables (spec 0003, AC-19). Decorative copy of the app.
interface Props {
  position: { readonly x: string; readonly y: string; readonly width: string };
}

const { position } = Astro.props;
---

<PopupCard position={position}>
  <p class="m-0 px-2 pt-1 pb-1.5 font-medium text-fg">Compare tables</p>
  <div class="flex items-center gap-2 px-2 pb-2 font-mono text-[0.92em]">
    <span class="rounded-inset border border-line bg-ground px-2 py-1">User</span>
    <span class="text-fg-muted">with</span>
    <span class="rounded-inset border border-line bg-ground px-2 py-1">User_copy</span>
  </div>
  <ul class="m-0 flex list-none flex-col gap-0.5 border-t border-line p-0 px-2 pt-1.5 pb-1 font-mono text-[0.85em]">
    <li><span class="text-syntax-string">+</span> 1 column only in User_copy</li>
    <li><span class="text-syntax-keyword">~</span> 4 rows differ</li>
    <li class="text-fg-muted">= 78 rows match</li>
  </ul>
</PopupCard>
