---
import PopupCard from '../../editor/PopupCard.astro';
import Tok from '../../editor/Tok.astro';

// Aggregation builder: one $match stage card (spec 0008, AC-18). Decorative copy
// of the app, taken from the screenshot's managers data, never a password or salt.
interface Props {
  position: { readonly x: string; readonly y: string; readonly width: string };
}

const { position } = Astro.props;
---

<PopupCard position={position}>
  <p class="m-0 flex items-center justify-between px-2 pt-1 pb-1.5">
    <span class="font-mono text-[0.85em] font-semibold"><span class="text-fg-muted">1</span> $match</span>
    <span class="rounded-inset border border-line px-1.5 font-mono text-[0.77em] text-fg-muted">1 condition</span>
  </p>
  <div class="flex items-center gap-1.5 px-1">
    <span class="flex-1 rounded-inset border border-line bg-ground px-2 py-1 font-mono text-[0.92em]">designation</span>
    <span class="rounded-inset border border-line bg-ground px-2 py-1 font-mono text-[0.92em]"><Tok kind="punctuation">=</Tok></span>
    <span class="flex-1 rounded-inset border border-line bg-ground px-2 py-1 font-mono text-[0.92em]"><Tok kind="string">"MANAGER"</Tok></span>
  </div>
  <p class="m-0 mt-2 border-t border-line px-2 pt-1.5 font-mono text-[0.85em] text-fg-muted">12 documents</p>
</PopupCard>
