---
import KeyRound from '@lucide/astro/icons/key-round';
import Link2 from '@lucide/astro/icons/link-2';
import PopupCard from '../../editor/PopupCard.astro';

// Schema designer: one foreign key, as shown when a link is selected (spec 0003, AC-19). Decorative copy of the app.
interface Props {
  position: { readonly x: string; readonly y: string; readonly width: string };
}

const { position } = Astro.props;
---

<PopupCard position={position}>
  <p class="m-0 px-2 pt-1 pb-1.5 font-medium text-fg-muted">Foreign key</p>
  <div class="flex items-center gap-2 px-2 font-mono text-[0.92em]">
    <span class="flex items-center gap-1 rounded-inset border border-line bg-ground px-2 py-1"><Link2 class="size-3 text-fg-muted" />User.roleId</span>
    <span class="text-fg-muted">to</span>
    <span class="flex items-center gap-1 rounded-inset border border-line bg-ground px-2 py-1"><KeyRound class="size-3 text-fg-muted" />Role.id</span>
  </div>
  <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 px-2 pt-2 pb-1">
    <dt class="text-fg-muted">on delete</dt>
    <dd class="m-0 font-mono text-[0.92em]">set null</dd>
    <dt class="text-fg-muted">on update</dt>
    <dd class="m-0 font-mono text-[0.92em]">cascade</dd>
  </dl>
</PopupCard>
