---
import PopupCard from '../../editor/PopupCard.astro';
import Tok from '../../editor/Tok.astro';

// Query builder: a join clause card between User and Role (spec 0003, AC-19). Decorative copy of the app.
interface Props {
  position: { readonly x: string; readonly y: string; readonly width: string };
}

const { position } = Astro.props;
---

<PopupCard position={position}>
  <p class="m-0 flex items-center justify-between px-2 pt-1 pb-1.5">
    <span class="font-mono text-[0.85em] font-semibold tracking-wide">3 JOIN</span>
    <span class="rounded-inset border border-line px-1.5 font-mono text-[0.77em] text-fg-muted">inner</span>
  </p>
  <div class="flex items-center gap-2 px-2 font-mono text-[0.92em]">
    <span class="flex-1 rounded-inset border border-line bg-ground px-2 py-1">"User"</span>
    <span class="text-fg-muted">with</span>
    <span class="flex-1 rounded-inset border border-line bg-ground px-2 py-1">"Role"</span>
  </div>
  <p class="m-0 px-2 pt-2 pb-1 font-mono text-[0.92em]">
    <Tok kind="keyword">on</Tok> "roleId" <Tok kind="punctuation">=</Tok> id
  </p>
</PopupCard>
