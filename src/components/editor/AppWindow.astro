---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

// A real product screenshot framed as an app window (spec 0002). Raised and
// flat on the page: no tilt, no fade, no glass. It is the positioned parent the
// PopupCards float over. The title bar is decorative, so the `alt` carries the
// meaning. `bare` drops the frame and title bar for a capture that already
// holds its own window and shadow.
interface Props {
  image: ImageMetadata;
  /** The same capture in the light theme; the window shows the one that matches the site theme. */
  imageLight?: ImageMetadata | undefined;
  alt: string;
  title: string;
  /** The capture already shows its own window, so no frame or title bar is drawn. */
  bare?: boolean;
  /** Load the screenshot at once, for a window above the fold. */
  eager?: boolean;
  /** Rendered width hints. The default suits a window as wide as the content column. */
  sizes?: string;
  class?: string;
}

const { image, imageLight, alt, title, bare = false, eager = false, sizes = '(min-width: 72rem) 72rem, 100vw', class: className } = Astro.props;
---

<figure class:list={[bare ? 'window-shot' : 'window', className]}>
  {
    !bare && (
      <div class="window-chrome" aria-hidden="true">
        <span class="flex gap-1.5">
          <span class="size-2.5 rounded-pill bg-line" />
          <span class="size-2.5 rounded-pill bg-line" />
          <span class="size-2.5 rounded-pill bg-line" />
        </span>
        <span class="truncate text-caption text-fg-muted">{title}</span>
        <span />
      </div>
    )
  }
  <div class="window-body">
    {
      [{ src: image, theme: imageLight === undefined ? undefined : 'dark' }, ...(imageLight === undefined ? [] : [{ src: imageLight, theme: 'light' }])].map(
        (shot) => (
          <Picture
            src={shot.src}
            alt={alt}
            widths={[480, 800, 1200, 1600, 2304]}
            sizes={sizes}
            formats={['avif', 'webp']}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            pictureAttributes={{ 'data-shot-theme': shot.theme }}
          />
        ),
      )
    }
  </div>
  <slot />
</figure>
