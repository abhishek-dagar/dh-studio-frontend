---
import { getEntry } from 'astro:content';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatReleaseDate } from '../lib/home/format';
import { privacyBody } from '../lib/privacy/body';
import { resultClass, resultGridClass } from '../lib/ui/result';

// The privacy notice (spec 0007): the Markdown body, split once to place the
// files grid inside the app section. No island, so it reads the same without
// JavaScript. The body is our own content, so it goes in as trusted HTML.
const page = await getEntry('privacy', 'privacy');
if (page === undefined) {
  throw new Error(
    '[privacy] No "privacy" entry. Check that src/content/privacy/privacy.md exists. ' +
      'If src/content.config.ts was added while the dev server ran, restart it so the collection syncs.',
  );
}

const { meta, updated, appVersion, operator, contact, files } = page.data;
const body = privacyBody(page.rendered?.html ?? '', operator, contact);
if (!body.ok) throw new Error(`[privacy] src/content/privacy/privacy.md ${body.error} (spec 0007, AC-13).`);

const updatedIso = updated.toISOString();
---

<BaseLayout title={meta.title} description={meta.description}>
  <Section class="pt-10 md:pt-16">
    <Container class="flex max-w-3xl flex-col gap-10">
      <header class="flex flex-col gap-3">
        <h1 class="text-h1">Privacy</h1>
        <p class="text-caption text-fg-muted">
          Last updated <time datetime={updatedIso.slice(0, 10)}>{formatReleaseDate(updatedIso)}</time> · Checked against DH Studio {
            appVersion
          }
        </p>
      </header>

      <div class="privacy-body">
        <Fragment set:html={body.value.before} />
        <div class="privacy-files">
          <table class={resultGridClass()}>
            <caption>Files in the DH Studio data folder</caption>
            <thead>
              <tr>
                <th scope="col">file</th>
                <th scope="col">holds</th>
                <th scope="col">encrypted</th>
              </tr>
            </thead>
            <tbody>
              {
                files.map((file) => (
                  <tr>
                    <th scope="row" class={resultClass.mono}>
                      {file.name}
                    </th>
                    <td>{file.holds}</td>
                    <td class={resultClass.mono}>{file.encrypted ? 'yes' : 'no'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <Fragment set:html={body.value.after} />
      </div>
    </Container>
  </Section>
</BaseLayout>

<style is:global>
  /* The notice comes from markdown, so it is styled here, following .release-notes (design.md, Changelog). */
  .privacy-body {
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .privacy-body > :first-child {
    margin-block-start: 0;
  }

  .privacy-body h2 {
    scroll-margin-top: calc(var(--header-offset) + var(--header-h) + 1rem);
    margin-block: 2.5rem 0.75rem;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: 600;
  }

  .privacy-body > h2:first-child {
    margin-block-start: 0;
  }

  .privacy-body :is(p, ul) {
    margin-block: 0.75rem;
    max-inline-size: var(--width-prose);
  }

  .privacy-body ul {
    padding-inline-start: 1.25rem;
    list-style: disc;
  }

  .privacy-body li + li {
    margin-block-start: 0.375rem;
  }

  .privacy-body li::marker {
    color: var(--fg-muted);
  }

  .privacy-body strong {
    font-weight: 600;
  }

  .privacy-body a[href] {
    color: var(--fg);
    text-decoration: underline 1px var(--line-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-fast);
  }

  .privacy-body a[href]:hover {
    text-decoration-color: var(--fg);
  }

  /* Inline code, in Kbd's quiet chip. Long paths break inside the chip on a phone (AC-14). */
  .privacy-body code {
    border: 1px solid var(--line);
    border-radius: var(--radius-inset);
    background: var(--ground);
    padding: 0.05em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  /* The files grid in a flat frame that scrolls sideways inside itself (AC-8, AC-14). */
  .privacy-files {
    margin-block: 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    background: var(--surface);
    overflow-wrap: normal;
  }

  .privacy-files tbody th {
    white-space: nowrap;
  }

  @media (forced-colors: active) {
    .privacy-files {
      border-color: CanvasText;
    }
  }
</style>
