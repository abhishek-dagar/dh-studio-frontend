---
import type { GetStaticPaths } from 'astro';
import Rss from '@lucide/astro/icons/rss';
import ChangelogPager from '../../components/changelog/ChangelogPager.astro';
import ReleaseMeta from '../../components/changelog/ReleaseMeta.astro';
import ReleaseNotes from '../../components/changelog/ReleaseNotes.astro';
import Container from '../../components/ui/Container.astro';
import Link from '../../components/ui/Link.astro';
import Section from '../../components/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  CHANGELOG_PATH,
  changelogCopy,
  fill,
  isLatest,
  neighbors,
  pageDescription,
  pageTitle,
  releaseEntries,
  versionPath,
  type ReleaseEntry,
} from '../../lib/changelog';
import { latestRelease } from '../../lib/release';
import { RELEASES_FEED_URL } from '../../lib/release/config';
import { linkClass } from '../../lib/ui/link';

// One release's own page (spec 0005, AC-9, AC-13), the link that never moves.
// Newer and older follow the All order.
export const getStaticPaths = (async () => {
  const entries = await releaseEntries();
  return entries.map((entry) => ({
    params: { version: entry.id },
    props: { entry, ...neighbors(entries, entry.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: ReleaseEntry;
  newer?: ReleaseEntry;
  older?: ReleaseEntry;
}

const { entry, newer, older } = Astro.props;
const [copy, release] = await Promise.all([changelogCopy(), latestRelease]);
const { version, publishedAt, prerelease, pageUrl } = entry.data;
const subject = { kind: 'version', version, publishedAt } as const;
---

<BaseLayout title={pageTitle(subject, copy)} description={pageDescription(subject, copy)} feedUrl={RELEASES_FEED_URL}>
  <Section class="pt-10 md:pt-16">
    <Container class="flex max-w-3xl flex-col gap-8">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[0.875rem]">
        <Link href={CHANGELOG_PATH} class="inline-flex min-h-11 items-center">{copy.release.allReleases}</Link>
        <a href={RELEASES_FEED_URL} class:list={[linkClass, 'inline-flex min-h-11 items-center gap-2']}>
          <Rss class="size-4 shrink-0 text-fg-muted" aria-hidden="true" />
          {copy.subscribe}
        </a>
      </div>

      <header class="flex flex-col gap-3">
        <h1 class="text-h1">{fill(copy.release.heading, { version })}</h1>
        <ReleaseMeta publishedAt={publishedAt} prerelease={prerelease} latest={isLatest(release, version)} copy={copy.entry} />
      </header>

      <section aria-labelledby="release-notes" class="flex flex-col gap-4">
        <h2 id="release-notes" class="text-h3 text-fg-muted">{copy.release.notesHeading}</h2>
        <ReleaseNotes entry={entry} emptyNotes={copy.entry.emptyNotes} />
        <p class="text-caption"><Link href={pageUrl}>{copy.entry.github}</Link></p>
      </section>

      <ChangelogPager
        label={copy.pages.label}
        newer={newer === undefined ? undefined : { href: versionPath(newer.id), text: `${copy.pages.newer}: ${newer.id}` }}
        older={older === undefined ? undefined : { href: versionPath(older.id), text: `${copy.pages.older}: ${older.id}` }}
      />
    </Container>
  </Section>
</BaseLayout>
